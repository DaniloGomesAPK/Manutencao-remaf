# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - REMAF / DG GESTÃO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GEMINI & PLATAFORMA (Injetado automaticamente no AI Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 2. FIREBASE WEB SDK (Variáveis Públicas do Frontend - Vite / Vercel)
# Obrigatório para o funcionamento do app no navegador (Auth, Firestore, Analytics)
# IMPORTANTE: Cadastre sem aspas na Vercel e no .env para evitar erros de autenticação.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (Segredos Privados do Backend / Server-Side / Vercel)
# CRÍTICO: NUNCA expor no frontend ou commitar chaves reais.
# Utilizado exclusivamente pelo Node.js/Express e Serverless Functions (/api/*).
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. ADMINISTRAÇÃO E INTEGRAÇÕES DE BACKEND
# ------------------------------------------------------------------------------
# E-mails de administradores autorizados do sistema (separados por vírgula)
SYSTEM_ADMIN_EMAILS=admin1@empresa.com,admin2@empresa.com

# Integração de Webhook Cakto (Opcional - desativado por padrão)
CAKTO_WEBHOOK_ENABLED=false
CAKTO_WEBHOOK_SECRET=seu_segredo_de_webhook_aqui
