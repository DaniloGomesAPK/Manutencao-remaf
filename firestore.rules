rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES DE VALIDAÇÃO ---
    function usuarioAutenticado() {
      return request.auth != null;
    }

    // Verifica se o e-mail do usuário está cadastrado na coleção de autorizados
    function emailAutorizado() {
      return usuarioAutenticado() &&
             exists(/databases/$(database)/documents/emailsAutorizados/$(request.auth.token.email));
    }

    // --- REGRAS POR COLEÇÃO ---

    // Coleção de e-mails autorizados (Permite apenas a checagem pelo sistema)
    match /emailsAutorizados/{email} {
      allow read: if usuarioAutenticado();
      allow write: if false; 
    }

    // Perfil de usuário (O UID do documento deve ser igual ao UID autenticado)
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid && emailAutorizado();
    }

    // Empresas (Ajustado para aceitar se o ID contiver o UID do usuário)
    match /empresas/{empresaId} {
      allow read, write: if (request.auth.uid == empresaId || empresaId == "emp_" + request.auth.uid) && emailAutorizado();

      // Subcoleção de licenças da empresa (Apenas leitura)
      match /licenca/{document=**} {
        allow read: if (request.auth.uid == empresaId || empresaId == "emp_" + request.auth.uid) && emailAutorizado();
        allow create, update, delete: if false;
      }

      // Outras subcoleções da empresa (Cadastros gerais do sistema, como company_profile)
      match /{subcollection}/{document=**} {
        allow read, write: if (request.auth.uid == empresaId || empresaId == "emp_" + request.auth.uid) && emailAutorizado();
      }
    }

    // Coleção Global de Clientes (Adicionada para permitir que usuários autorizados mexam nos clientes)
    match /clientes/{clienteId} {
      allow read, write: if emailAutorizado();
    }
  }
}
