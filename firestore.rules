rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES DE VALIDAÇÃO DE SEGURANÇA E TRIAL ---
    
    // Verifica se o usuário está autenticado no Firebase Auth
    function usuarioAutenticado() {
      return request.auth != null;
    }

    // Verifica se o período de Trial de 7 dias ainda está válido com base no tempo do servidor (request.time)
    function trialAtivo(criadoEm) {
      return criadoEm is timestamp && request.time < criadoEm + duration.value(7, 'd');
    }

    // --- REGRAS DA COLEÇÃO EMPRESAS ---
    match /empresas/{empresaId} {
      
      // 1. Criação do Trial:
      // Permite criar apenas se o status for exatamente 'trial' e 'criadoEm' for rigorosamente o serverTimestamp()
      allow create: if request.resource.data.status == 'trial'
                    && request.resource.data.criadoEm == request.time;

      // 2. Leitura (get, list) e Atualização (update):
      // Permite ler e atualizar apenas se a requisição ocorrer dentro da janela de 7 dias a partir do criadoEm
      allow read, update: if trialAtivo(resource.data.criadoEm);

      // 3. Exclusão (delete):
      // Bloqueada para proteger os registros contra remoção não autorizada
      allow delete: if false;

      // Subcoleções internas da empresa (ex: clientes, ordensServico, etc.)
      match /{subcollection}/{document=**} {
        allow read, create, update: if trialAtivo(get(/databases/$(database)/documents/empresas/$(empresaId)).data.criadoEm);
        allow delete: if false;
      }
    }

    // Coleção de e-mails autorizados (leitura e cadastros de trial)
    match /emailsAutorizados/{email} {
      allow read: if true;
      allow create, update: if request.resource.data.status == 'trial' || request.auth != null;
      allow delete: if false;
    }

    // Perfil de Usuário
    match /users/{uid} {
      allow read, write: if true;
    }

    // Coleção Global de Clientes
    match /clientes/{clienteId} {
      allow read, write: if true;
    }
  }
}
