rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function usuarioAutenticado() {
      return request.auth != null;
    }

    // Verifica se o e-mail do usuário está autorizado
    function emailAutorizado() {
      return usuarioAutenticado() &&
             exists(/databases/$(database)/documents/emailsAutorizados/$(request.auth.token.email));
    }

    // Perfil de usuário
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid && emailAutorizado();
    }

    // Empresas
    match /empresas/{empresaId} {
      allow read, write: if request.auth.uid == empresaId && emailAutorizado();

      match /licenca/{document=**} {
        allow read: if request.auth.uid == empresaId && emailAutorizado();
        allow create, update, delete: if false;
      }

      match /{subcollection}/{document=**} {
        allow read, write: if request.auth.uid == empresaId && emailAutorizado();
      }
    }

    // Bloqueio global
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
